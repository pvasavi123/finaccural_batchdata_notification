{
  "name": "finaccrual-node",
  "version": "1.0.0",
  "description": "Enterprise Resource Planning (ERP) Backend System",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "dev:1": "cross-env PORT=8000 INSTANCE_ID=server-1 nodemon src/server.js",
    "dev:2": "cross-env PORT=8001 INSTANCE_ID=server-2 nodemon src/server.js",
    "dev:all": "concurrently \"npm run dev:1\" \"npm run dev:2\"",
    "test": "jest",
    "test:watch": "jest --watch",
    "lint": "eslint src/**/*.js",
    "lint:fix": "eslint src/**/*.js --fix",
    "format": "prettier --write \"src/**/*.js\"",
    "loadtest": "node scripts/loadtest.js"
  },
  "keywords": [
    "erp",
    "backend",
    "node",
    "express",
    "sequelize"
  ],
  "author": "Y.Abhilash Reddy",
  "license": "MIT",
  "type": "commonjs",
  "dependencies": {
    "axios": "^1.18.1",
    "bcrypt": "^6.0.0",
    "connect-redis": "^10.0.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.2",
    "express-session": "^1.19.0",
    "helmet": "^8.3.0",
    "joi": "^18.2.3",
    "jsonwebtoken": "^9.0.3",
    "mysql2": "^3.23.0",
    "redis": "^6.2.1",
    "sequelize": "^6.37.8",
    "sqlite3": "^6.0.1"
  },
  "devDependencies": {
    "autocannon": "^8.0.0",
    "concurrently": "^9.2.4",
    "cross-env": "^10.1.0",
    "eslint": "^9.15.0",
    "jest": "^29.7.0",
    "nodemon": "^3.1.7",
    "prettier": "^3.3.3",
    "supertest": "^7.0.0"
  }
}
