# Application Configuration
PORT=8000
NODE_ENV=development
 
# Session Configuration
SESSION_SECRET=your_session_secret
JWT_SECRET=finaccural-jwt-secret-key-12345
 
# Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_NAME=quickbooks_xero
DB_USER=root
DB_PASSWORD=anu@1234

# Set to 'true' only when you've just changed a Sequelize model and want
# server.js to ALTER the live tables to match. Leave unset/false for normal
# day-to-day restarts — repeatedly altering on every nodemon restart piles
# up duplicate unique indexes on MySQL until it hits the 64-key limit.
DB_SYNC_ALTER=false

# Trial Configuration
# Duration of a new signup's trial, in milliseconds. 120000 = 2 minutes,
# handy for testing the expiry flow quickly. Switch to something like
# 1209600000 (14 days) before this goes anywhere real.
TRIAL_DURATION_MS=120000
TRIAL_DEFAULT_PLAN=trial

# QuickBooks Configuration
QB_CLIENT_ID=ABGLYJbESXj6znYwinUxFXzmAldBHKaownNrbr7ergQUWWSgjc
QB_CLIENT_SECRET=Eiz4QPO796Q7J4OqCCQCiWlq28tc4M1vFobWXuN9
QB_REDIRECT_URI=http://localhost:8000/api/quickbooks/callback
QB_ENVIRONMENT=sandbox
 
# Xero Configuration
XERO_CLIENT_ID=610877E2482E470A9BBA63A9BC2367E7
XERO_CLIENT_SECRET=eQoCQEXGof1l4Z5SLWoAB22Hi9FNoAH4iKjY2e_W8DzNSulZ
XERO_REDIRECT_URI=http://localhost:8000/api/xero/callback
XERO_SCOPES=openid profile email offline_access accounting.contacts accounting.settings.read

# Logging Configuration
LOG_LEVEL=info

# Google Configuration
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback

# Microsoft Entra ID (Azure AD) Configuration
# Register the app at https://portal.azure.com > Entra ID > App registrations.
# Redirect URI below MUST match exactly what's registered on the app (Web platform).
MICROSOFT_CLIENT_ID=your_microsoft_application_client_id
MICROSOFT_CLIENT_SECRET=your_microsoft_client_secret
MICROSOFT_REDIRECT_URI=http://localhost:8000/api/microsoft/callback
# 'common' = personal + work/school accounts. Use a tenant GUID to restrict to one org.
MICROSOFT_TENANT_ID=consumers
